{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "bunVersion": "1.4.x",
  "cleanUrls": true,
  "functions": {
    "index.ts": {
      "includeFiles": "node_modules/@better-auth/**"
    },
    "server.ts": {
      "includeFiles": "node_modules/@better-auth/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 0 * * *"
    }
  ]
}
